# Copy this file to .env and fill in real values before running the server.

# Port the API server listens on
PORT=5000

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API from the browser
# (the SIH frontend is plain static HTML/JS, e.g. served from Live Server or file://)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Attendance threshold used for the 75% tracker logic
ATTENDANCE_THRESHOLD=75
